rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check for admin role
    function isAdmin() {
      // Check if the user is authenticated and if their user document shows they are an admin.
      return request.auth != null && 
             exists(/databases/{database}/documents/users/$(request.auth.uid)) &&
             get(/databases/{database}/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for the products folder
    match /products/{allPaths=**} {
      // Allow public read access for all product images so anyone can view them.
      allow read: if true;
      
      // Allow create, update, and delete operations ONLY for admin users.
      // This single "allow write" covers all modification actions.
      allow write: if isAdmin();
    }
  }
}
