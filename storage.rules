rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Helper function to check for admin role from Firestore
    function isAdmin() {
      return exists(/databases/{database}/documents/users/$(request.auth.uid)) &&
             get(/databases/{database}/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  
    match /products/{allPaths=**} {
      // Allow public read access for anyone to view product images
      allow read;
      
      // Allow create and update access only for admin users
      allow create, update: if isAdmin();

      // Explicitly allow delete access for admin users
      allow delete: if isAdmin();
    }
  }
}
