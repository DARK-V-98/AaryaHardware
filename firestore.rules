rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      // Check if the user has an 'admin' role in their user document
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products: public read, admin-only write, but allow quantity updates for checkout
    match /products/{productId} {
      allow get: if true; // Allow anyone to get a single product
      allow list: if true; // Allow anyone to list products

      // Admins can create and delete products
      allow create, delete: if isAdmin();

      // Allow updates under specific conditions:
      // 1. Full updates for admins
      // 2. Quantity-only updates for any authenticated user (for checkout transaction)
      allow update: if isAdmin() || 
                     (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
    }

    // Categories: public read, admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: users can create/read their own, admins can read/update all
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      allow update: if isAdmin(); // Only admins can update order status
      
      allow delete: if false; // Never allow deleting orders
    }

    // Users: users can read their own role, admins can write roles
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}
