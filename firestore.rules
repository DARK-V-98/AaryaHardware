
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      // Check if the user is authenticated and has an 'admin' role in the 'users' collection.
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products can be read by anyone.
    // They can be fetched individually (get) by any authenticated user for cart/checkout validation.
    // They can only be listed, created, updated, or deleted by admins.
    match /products/{productId} {
      allow get: if request.auth != null; // Allows fetching a single product
      allow list: if true; // Allows fetching collections of products
      allow write: if isAdmin(); // Create, update, delete only for admins
    }

    // Categories can be read by anyone, but only written by admins.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders can be created by any authenticated user for themselves.
    // They can only be read by the user who created them or by an admin.
    // They can only be updated by an admin. Deletion is disallowed.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false; // Disallow deletion for data integrity
    }

    // User data can be read by the user themselves or an admin.
    // Only admins can modify user roles.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
