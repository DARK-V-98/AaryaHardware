
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      // Check for the existence of the user document and their role.
      // This is more secure than just checking the role.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Products: Read by all, managed by admins.
    // Customers can only update quantity.
    match /products/{productId} {
      allow read: if true;
      
      // Admins can create and delete products.
      allow create, delete: if isAdmin();

      // Admins can update any field.
      // Authenticated customers can ONLY update the quantity field.
      allow update: if isAdmin() || 
                      (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity']));
    }

    // Categories: Read by all, managed by admins.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Customers can create their own orders.
    // - Customers can read their own orders.
    // - Admins can read and update any order.
    // - No one can delete orders to maintain history.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if false; // Disallow deletion of orders
    }

    // Users:
    // - Users can read their own data.
    // - Admins can read and write to any user document (to manage roles).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
      // Allow an admin to see all users.
      allow list: if isAdmin();
    }
  }
}
