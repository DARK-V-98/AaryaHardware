rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /products/{productId} {
      // Anyone can read products.
      allow read;

      // Only admins can create, update, or delete products.
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      // Anyone can read categories.
      allow read;

      // Only admins can write to categories.
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Users can only see their own data, admins can see any.
      allow get: if request.auth.uid == userId || isAdmin();
      
      // Only admins can list users or change roles.
      allow list, write: if isAdmin();
    }

    match /orders/{orderId} {
      // A user can create their own order.
      allow create: if request.auth.uid != null;
      
      // Admins can see/update any order. Users can only see their own.
      allow get, list, update: if isAdmin() || (request.auth.uid == resource.data.userId);

      // No one can delete orders to maintain history.
      allow delete: if false;
    }
  }
}
